{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsc-node",
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vite.lib.config.ts", "vite.plugins.ts", "src/types/**/*.d.ts"]
}
